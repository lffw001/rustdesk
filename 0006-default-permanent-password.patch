+/// 确保被控端始终可用固定密码连接：首次启动时，若未配置过永久密码，
+/// 则写入下面预设的默认密码，并将验证方式默认为仅永久密码。
+/// 使用前请将 DEFAULT_PERMANENT_PASSWORD 改成你自己的密码；
+/// 若 fork 为公开仓库，密码会被所有人看到，建议将 fork 设为私有。
+fn ensure_default_permanent_password() {
+    const DEFAULT_PERMANENT_PASSWORD: &str = "";
+    if Config::get_option("verification-method").is_empty() {
+        Config::set_option(
+            "verification-method".to_owned(),
+            "use-permanent-password".to_owned(),
+        );
+    }
+    if !DEFAULT_PERMANENT_PASSWORD.is_empty() && !Config::has_permanent_password() {
+        if !Config::set_permanent_password(DEFAULT_PERMANENT_PASSWORD) {
+            log::error!("Failed to set default permanent password");
+        }
+    }
+}
