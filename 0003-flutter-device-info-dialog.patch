+
+/// "Device info" dialog: network details + system details for a peer.
+///
+/// [peerId] is the remote ID. [peer] (address book card) supplies the
+/// alias/hostname for the title and the online flag; [delay] (in-session
+/// toolbar) is the live network delay. The live connection type
+/// (direct/relay) comes from the global [ConnectionTypeState] while a
+/// session exists. System info is read from the per-peer cache written at
+/// connect time (see `handlePeerInfo` in `models/model.dart`), so offline
+/// peers show last-known data.
+Future<void> showDeviceInfoDialog(
+  BuildContext context, {
+  required String peerId,
+  Peer? peer,
+  String? delay,
+}) async {
+  Map<String, dynamic> sysinfo = {};
+  String cacheTime = '';
+  String cacheVersion = '';
+  try {
+    final raw = await bind.mainGetPeerOption(id: peerId, key: 'sysinfo_cache');
+    if (raw.isNotEmpty) {
+      final cache = jsonDecode(raw);
+      if (cache is Map<String, dynamic>) {
+        cacheTime = cache['time']?.toString() ?? '';
+        cacheVersion = cache['version']?.toString() ?? '';
+        final data = jsonDecode(cache['data']?.toString() ?? '');
+        if (data is Map<String, dynamic>) sysinfo = data;
+      }
+    }
+  } catch (_) {}
+  String lastSeen = '';
+  try {
+    lastSeen = await bind.mainGetPeerOption(id: peerId, key: 'last_seen');
+  } catch (_) {}
+
+  String? connType; // 'direct' / 'relay', only while a session is active
+  try {
+    if (Get.isRegistered<ConnectionType>(
+        tag: ConnectionTypeState.tag(peerId))) {
+      final ct = ConnectionTypeState.find(peerId);
+      if (ct.direct.value != kInvalidValueStr) {
+        connType = ct.direct.value == ConnectionType.strDirect
+            ? 'direct'
+            : 'relay';
+      }
+    }
+  } catch (_) {}
+
+  final titleName = peer?.alias.isNotEmpty == true
+      ? peer!.alias
+      : (peer?.hostname.isNotEmpty == true ? peer!.hostname : peerId);
+  // Toolbar (in-session) calls without a [peer]; a live delay implies online.
+  final online = peer?.online ?? delay?.isNotEmpty == true;
+
+  String v(String key) => sysinfo[key]?.toString() ?? '--';
+
+  gFFI.dialogManager.show((setState, close, context) {
+    Widget section(String title) => Padding(
+          padding: const EdgeInsets.only(top: 12, bottom: 4),
+          child: Text(title,
+              style:
+                  const TextStyle(fontWeight: FontWeight.bold, fontSize: 15)),
+        );
+
+    Widget row(String label, String value) => Padding(
+          padding: const EdgeInsets.symmetric(vertical: 3),
+          child: Row(
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              SizedBox(
+                  width: 96,
+                  child: Text(label,
+                      style: const TextStyle(color: Colors.grey))),
+              Expanded(child: SelectableText(value)),
+            ],
+          ),
+        );
+
+    final sysRows = <Widget>[];
+    if (sysinfo.isEmpty) {
+      sysRows.add(Padding(
+        padding: const EdgeInsets.symmetric(vertical: 3),
+        child: Text(online
+            ? translate('Controlled end too old')
+            : translate('No cached system info')),
+      ));
+    } else {
+      sysRows.addAll([
+        row('OS', v('os')),
+        row('CPU', v('cpu')),
+        row(translate('Memory'), v('memory')),
+        row(translate('Disk'), v('disks')),
+        row(translate('Architecture'), v('arch')),
+        row(translate('Uptime'), v('uptime')),
+        row(translate('Hostname'), v('hostname')),
+        row(translate('Username'), v('username')),
+        row(translate('Client version'),
+            cacheVersion.isNotEmpty ? cacheVersion : '--'),
+        row(translate('Cached at'),
+            cacheTime.isNotEmpty ? _fmtTime(cacheTime) : '--'),
+      ]);
+    }
+
+    return CustomAlertDialog(
+      title: Text('${translate('Device info')} - $titleName'),
+      content: ConstrainedBox(
+        constraints: const BoxConstraints(maxWidth: 440),
+        child: SingleChildScrollView(
+          child: Column(
+            mainAxisSize: MainAxisSize.min,
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              section(translate('Network details')),
+              row('ID', peerId),
+              row(translate('Status'),
+                  translate(online ? 'Online' : 'Offline')),
+              row(translate('Last seen'),
+                  lastSeen.isEmpty ? translate('Never') : _fmtTime(lastSeen)),
+              row(
+                  translate('Connection'),
+                  online && connType != null
+                      ? translate(connType == 'direct' ? 'Direct' : 'Relay')
+                      : '--'),
+              row(translate('Delay'),
+                  online && delay?.isNotEmpty == true ? delay! : '--'),
+              section(translate('System details')),
+              ...sysRows,
+            ],
+          ),
+        ),
+      ),
+      actions: [
+        TextButton(
+          onPressed: close,
+          child: Text(translate('Close')),
+        ),
+      ],
+      onCancel: close,
+    );
+  });
+}
+
+String _fmtTime(String iso) {
+  final dt = DateTime.tryParse(iso);
+  if (dt == null) return iso;
+  final l = dt.toLocal();
+  String p(int n) => n.toString().padLeft(2, '0');
+  return '${l.year}-${p(l.month)}-${p(l.day)} ${p(l.hour)}:${p(l.minute)}';
+}
