+const START_ON_BOOT_RUN_KEY: &str = r"Software\Microsoft\Windows\CurrentVersion\Run";
+
+// 开机自启动：写 HKCU 下的 Run 键，用户级，不用管理员权限。
+// 值名取程序名，值是带引号的当前 exe 全路径。
+pub fn get_start_on_boot() -> bool {
+    let Ok(exe) = std::env::current_exe() else {
+        return false;
+    };
+    let Ok(run_key) =
+        RegKey::predef(HKEY_CURRENT_USER).open_subkey_with_flags(START_ON_BOOT_RUN_KEY, KEY_READ)
+    else {
+        return false;
+    };
+    // 只认指向当前 exe 的项；路径挪走或改名后旧项失效，开关显示关闭。
+    let Ok(val) = run_key.get_value::<String, _>(crate::get_app_name()) else {
+        return false;
+    };
+    val.contains(&exe.to_string_lossy().to_string())
+}
+
+pub fn set_start_on_boot(enable: bool) {
+    if !enable && !get_start_on_boot() {
+        return;
+    }
+    let Ok((run_key, _)) =
+        RegKey::predef(HKEY_CURRENT_USER).create_subkey(START_ON_BOOT_RUN_KEY)
+    else {
+        return;
+    };
+    let name = crate::get_app_name();
+    if enable {
+        if let Ok(exe) = std::env::current_exe() {
+            let cmd = format!("\"{}\"", exe.to_string_lossy());
+            let _ = run_key.set_value(name, &cmd);
+        }
+    } else {
+        // 只删指向自己的项，不动别人写的同名项。
+        let _ = run_key.delete_value(name);
+    }
+}
